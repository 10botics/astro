---
import { Image, type ImageMetadata } from 'astro:assets';

export interface Props {
  isRemote: boolean;
  src: string | ImageMetadata;
  alt: string;
  /** Same idea as HeroSection `heroImageMaxScale`: object-contain, limited to this fraction of slide width. */
  maxScale?: number;
}

const { isRemote, src, alt, maxScale } = Astro.props;
const scaled =
  typeof maxScale === 'number' && maxScale > 0 && maxScale <= 1 ? maxScale : null;
const widthStyle = scaled != null ? ({ width: `${scaled * 100}%` } as const) : undefined;
const slideFrameClass =
  'relative w-full aspect-[4/3] overflow-hidden rounded-lg bg-gray-100';
const imageClass =
  scaled != null
    ? 'absolute inset-0 mx-auto h-full max-w-none block object-cover rounded-lg'
    : 'absolute inset-0 h-full w-full object-cover rounded-lg';
---

{
  scaled != null ? (
    <div class={`flex items-center justify-center w-full ${slideFrameClass}`}>
      {isRemote ? (
        <img
          src={src as string}
          alt={alt}
          class={imageClass}
          style={widthStyle}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <Image
          src={src as ImageMetadata}
          alt={alt}
          class={imageClass}
          style={widthStyle}
          loading="lazy"
          decoding="async"
        />
      )}
    </div>
  ) : isRemote ? (
    <div class={slideFrameClass}>
      <img
        src={src as string}
        alt={alt}
        class={imageClass}
        loading="lazy"
        decoding="async"
      />
    </div>
  ) : (
    <div class={slideFrameClass}>
      <Image
        src={src as ImageMetadata}
        alt={alt}
        class={imageClass}
        loading="lazy"
        decoding="async"
      />
    </div>
  )
}
