---
import Layout from '../layouts/Layout.astro';
import BrochureEnquiryForm from '../components/BrochureEnquiryForm.astro';

const title = "索取課程總覽 | 10教育";
const description = "填寫表格以索取我們的完整課程總覽，了解10教育提供的各種STEM及AI課程詳情。";
const keywords = "課程總覽, 課程資料, STEM課程, AI課程, 10教育, 索取資料";
---

<Layout 
  title={title}
  description={description}
  keywords={keywords}
>
  <!-- Form Section with proper spacing -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
        <img
          src="https://img.paperform.co/fetch/w_1200,f_auto/https://s3.amazonaws.com/pf-form-assets-01/u-178304/assets/2025-02-20/bm1334b/OFAB8X1-01.jpg"
          alt="10教育課程總覽"
          width="1200"
          height="587"
          class="w-full h-auto"
        />
        <div class="p-8 md:p-12">
          <div class="mb-8 text-center">
            <h1 class="text-3xl font-bold text-gray-900 mb-3">索取課程總覽</h1>
            <p class="text-gray-600">填寫以下資料，我們會將最新課程總覽發送到你的電郵。</p>
          </div>
          <BrochureEnquiryForm />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Smooth animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .container > div {
    animation: fadeInUp 0.6s ease-out;
  }
</style>
