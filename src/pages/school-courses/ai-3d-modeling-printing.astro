---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';

import printerImage from '../../assets/images/school-courses/AI啟蒙課程/meshy-ai.png';
import modelImage from '../../assets/images/school-courses/Unity 課程/3d-model.png';
import classroomImage from '../../assets/images/school-courses/ai-3d-modeling-printing/classroom-finishing.jpg';
import modelingClassroomImage from '../../assets/images/school-courses/ai-3d-modeling-printing/digital-modeling-classroom.jpg';
import studentWorkImage from '../../assets/images/school-courses/ai-3d-modeling-printing/student-work-collection.jpg';
import paintedCharacterImage from '../../assets/images/school-courses/ai-3d-modeling-printing/painted-character.jpg';

const pageTitle = '中小學 AI 3D 建模及打印課程｜人工智能創作到實體作品｜10教育';
const pageDescription = '10教育為香港中小學提供AI 3D建模及打印到校課程。學生運用生成式人工智能探索設計概念，再親手修改3D模型、檢查可打印性，將數碼創作製作成實體作品。';
const pageKeywords = '中小學AI課程,AI 3D建模,AI 3D打印,人工智能3D模型生成,生成式人工智能,到校AI課程,STEM課程,人工智能素養,數碼製造,香港中小學';

export const courseData = {
  title: 'AI 3D 建模及打印創作課程',
  subtitle: '由生成式人工智能概念走到可以觸摸的實體作品',
  description: '10教育為香港中小學提供AI 3D建模及打印到校課程。學生運用生成式人工智能探索設計概念，再親手修改3D模型、檢查可打印性，將數碼創作製作成實體作品。',
  detailedDescription: '學生運用生成式人工智能探索設計方向，辨識AI模型的限制，再以3D建模工具修改結構、尺寸及細節，學習切片、物料與打印準備，完成具個人創意的實體作品。',
  tags: ['AI 人工智能', '3D 打印', '3D 建模', 'STEM', '高小', '初中', '高中'],
  targetAudience: '高小至高中',
  duration: '6–10 節，每節 60–90 分鐘',
  heroImage: printerImage,
  publishDate: '2026-09-18',
};

const aiApplications = [
  {
    number: '01',
    title: '用 AI 探索設計方向',
    description: '從文字、草圖或參考圖像出發，嘗試不同提示和限制條件，快速比較多個創作方向。',
  },
  {
    number: '02',
    title: '判斷 AI 結果是否可用',
    description: '找出不合理比例、破面、過薄結構和無法打印的細節，理解生成結果並不等於完成設計。',
  },
  {
    number: '03',
    title: '以人手重建和改良',
    description: '調整尺寸、結構、文字和個人化元素，讓作品真正回應用途、使用者和製作條件。',
  },
  {
    number: '04',
    title: '說明自己的設計決定',
    description: '比較 AI 與人手方案，解釋取捨、修改原因及負責任使用生成內容的方法。',
  },
];

const stages = [
  ['01', '認識 AI 與數碼製造', '觀察AI生成的3D內容和實體打印品，了解由數碼檔案到成品的基本流程。'],
  ['02', '界定設計任務', '確認作品的使用者、用途、大小、功能與製作限制。'],
  ['03', '草圖與提示設計', '以草圖和自然語言表達構思，測試提示、參考圖和限制條件如何影響結果。'],
  ['04', '生成與比較方案', '建立多個AI概念，從創意、用途和可行性選出合適方向。'],
  ['05', '檢查 AI 模型', '找出幾何錯誤、比例問題、懸空結構和過度複雜的細節。'],
  ['06', '重建與個人化', '運用3D建模工具修改形狀、尺寸、結構、文字和裝飾。'],
  ['07', '為打印而設計', '考慮壁厚、強度、平衡、接合、支撐和物料用量。'],
  ['08', '切片與打印檢查', '預覽打印路徑、方向、支撐和預計用料，修正潛在問題。'],
  ['09', '測試和改善', '檢視原型或打印模擬，根據結果調整模型。'],
  ['10', '作品展示與反思', '呈現作品、創作過程和AI協作方式，分享設計取捨。'],
];

const projects = [
  ['fa-id-card', '個人化名牌或桌面擺設'],
  ['fa-school', '校本紀念品或校園吉祥物'],
  ['fa-box-open', '模組收納或文具配件'],
  ['fa-key', '匙扣、徽章或裝飾作品'],
  ['fa-gears', '簡單可動或可組裝設計'],
  ['fa-lightbulb', '學生提出的實用小產品'],
];

const outcomes = [
  ['生成式 AI 應用', '懂得以提示、草圖和限制條件探索設計，而不是接受第一個生成結果。'],
  ['3D 建模能力', '能夠修改模型的形狀、比例、尺寸和個人化細節。'],
  ['人工智能素養', '理解AI輸出的限制、原創性問題及使用者需要承擔的判斷責任。'],
  ['數碼製造知識', '認識切片、物料、支撐、壁厚及打印方向如何影響成品。'],
  ['設計與解難', '根據用途、限制和測試結果反覆改善作品。'],
  ['表達與反思', '能夠說明設計意念、AI參與方式及重要修改決定。'],
];

const faqs = [
  {
    question: '甚麼是 AI 3D 建模？',
    answer: 'AI 3D建模是利用文字、草圖或圖像協助產生3D概念或初步模型。課程不會把AI生成視為完成作品；學生仍要檢查結構、修改細節、加入尺寸，並確保模型適合打印。',
  },
  {
    question: 'AI 可以直接生成可打印的 3D 模型嗎？',
    answer: '部分模型可以直接使用，但AI結果經常出現破面、不合理比例、過薄結構或過多細節。學生會學習辨識和修正這些問題，這也是課程的重要學習部分。',
  },
  {
    question: '學生需要有 AI 或 3D 設計經驗嗎？',
    answer: '不需要。課程適合零基礎學生，內容和工具會按高小、初中或高中程度調整。學生具備基本電腦操作能力便可參加。',
  },
  {
    question: '這是 AI 課程還是 3D 打印課程？',
    answer: '兩者都是。學生會實際使用生成式AI發展設計概念，同時學習3D建模、可打印性、切片和數碼製造。重點是把AI概念轉化成真正可以製作的作品。',
  },
  {
    question: '可以使用學校現有的 3D 打印機嗎？',
    answer: '可以。我們會先確認打印機型號、切片軟件、多色配置和可用物料。使用學校打印機時，學校需提供兼容耗材及一般打印所需物資。',
  },
  {
    question: '如果學校沒有足夠打印設備怎麼辦？',
    answer: '學校可另行選用10教育的全彩3D打印製作服務。標準安排為每位學生一件經確認的全彩作品，重量上限25克；較大型、易碎或特別複雜的作品需另行評估。',
  },
  {
    question: '每位學生會完成甚麼？',
    answer: '學校可從個人化桌面用品、校本紀念品、收納配件、匙扣、裝飾或簡單組裝作品中選定共同方向。學生會完成自己的3D設計檔案；實體成品安排視乎選用的打印方案。',
  },
  {
    question: '課程可以配合學校的 AI 或 STEM 學習目標嗎？',
    answer: '可以。我們會按學生年級、課程節數、學校設備和校本主題，調整人工智能素養、設計思維、3D建模和數碼製造的比重。課程內容可配合學校相關學習方向，但不代表任何資助申請必然獲批。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: courseData.title,
  description: pageDescription,
  provider: {
    '@type': 'Organization',
    name: '10教育',
    sameAs: 'https://www.10botics.com/',
  },
  educationalLevel: '高小至高中',
  inLanguage: 'zh-HK',
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} ogImage={printerImage.src}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />

  <div class="bg-white text-slate-900">
    <header class="relative isolate overflow-hidden bg-slate-950 text-white">
      <Image
        src={printerImage}
        alt="AI 3D建模概念透過3D打印製作成實體作品"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-950 via-slate-950/90 to-cyan-950/30"></div>
      <div class="container-standard py-24 md:py-32 lg:py-36">
        <div class="max-w-3xl">
          <p class="mb-5 inline-flex rounded-full border border-cyan-300/40 bg-slate-950/60 px-4 py-2 text-sm font-bold tracking-wide text-cyan-200 backdrop-blur">
            中小學到校 AI 課程｜6–10 節
          </p>
          <h1 class="text-4xl font-black leading-tight md:text-6xl">AI 3D 建模及<br />打印創作課程</h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-100 md:text-xl">結合生成式人工智能、3D 建模與打印技術，讓學生把創意概念轉化成可以觸摸的實體作品。</p>
          <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
            <a href="#contact-form" class="rounded-lg bg-cyan-400 px-7 py-3.5 text-center font-bold text-slate-950 transition hover:bg-cyan-300">索取課程方案及報價</a>
            <a href="#learning-path" class="rounded-lg border border-white/40 bg-white/10 px-7 py-3.5 text-center font-semibold text-white backdrop-blur transition hover:bg-white/20">查看學習流程</a>
          </div>
        </div>
      </div>
    </header>

    <section class="border-b border-slate-200 bg-white">
      <div class="container-standard grid gap-6 py-8 text-center sm:grid-cols-3 sm:divide-x sm:divide-slate-200">
        <div><p class="text-2xl font-black text-cyan-700">生成式 AI</p><p class="mt-1 text-sm text-slate-600">從提示和草圖探索設計</p></div>
        <div><p class="text-2xl font-black text-cyan-700">人手改良</p><p class="mt-1 text-sm text-slate-600">判斷、重建及加入細節</p></div>
        <div><p class="text-2xl font-black text-cyan-700">實體製作</p><p class="mt-1 text-sm text-slate-600">為打印而設計和測試</p></div>
      </div>
    </section>

    <section class="section-padding bg-slate-50">
      <div class="container-standard">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">真正運用人工智能</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">AI 不只是按一下生成</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">學生需要比較方案、發現問題、作出修改並解釋自己的設計決定。AI加快探索，但作品能否實際製作，仍取決於人的判斷。</p>
        </div>
        <div class="grid gap-6 lg:grid-cols-4">
          {aiApplications.map((item) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <span class="text-sm font-black tracking-[0.16em] text-cyan-700">{item.number}</span>
              <h3 class="mt-4 text-xl font-bold">{item.title}</h3>
              <p class="mt-3 leading-7 text-slate-600">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-padding bg-white">
      <div class="container-standard grid items-center gap-12 lg:grid-cols-[1.08fr_.92fr]">
        <div>
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">從數碼概念到實物</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">把創作放進真實世界測試</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">一個畫面看起來吸引，不代表它能夠打印。學生會逐步考慮尺寸、壁厚、平衡、懸空結構、支撐和物料用量，學習數碼設計與實體製造之間的差異。</p>
          <div class="mt-7 grid gap-3 sm:grid-cols-2">
            {['檢查幾何和破面', '調整尺寸與比例', '控制支撐和物料', '透過測試反覆改善'].map((item) => (
              <div class="flex items-center gap-3 rounded-xl bg-cyan-50 px-4 py-3 font-semibold text-slate-800"><span class="text-cyan-600">✓</span>{item}</div>
            ))}
          </div>
        </div>
        <div class="overflow-hidden rounded-3xl border border-slate-200 bg-slate-100 shadow-xl">
          <Image src={modelImage} alt="學生修改3D模型的尺寸、結構和打印細節" class="h-full min-h-80 w-full object-cover" widths={[640, 960]} sizes="(min-width: 1024px) 42vw, 100vw" />
        </div>
      </div>
    </section>

    <section id="learning-path" class="section-padding scroll-mt-24 bg-slate-950 text-white">
      <div class="container-standard">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-300">完整創作流程</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">課程可按 6–10 節靈活組合</h2>
          <p class="mt-5 text-lg leading-8 text-slate-300">以下是完整課程框架。實際內容會按學生年級、每節時長、設備和選定作品調整。</p>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          {stages.map(([number, title, description]) => (
            <article class="grid grid-cols-[3.2rem_1fr] gap-4 rounded-2xl border border-white/10 bg-white/5 p-5">
              <span class="text-2xl font-black text-cyan-300">{number}</span>
              <div><h3 class="text-lg font-bold">{title}</h3><p class="mt-2 leading-7 text-slate-300">{description}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-padding bg-cyan-50">
      <div class="container-standard">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">校本創作主題</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">先選定方向，再讓每位學生發揮</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">學校可先選擇共同作品方向，方便安排教學和打印；學生再透過外形、文字、結構和細節建立自己的版本。</p>
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map(([icon, title]) => (
            <article class="flex items-center gap-4 rounded-2xl bg-white p-6 shadow-sm"><span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-cyan-100 text-xl text-cyan-700"><i class={`fas ${icon}`}></i></span><h3 class="text-lg font-bold">{title}</h3></article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-padding bg-white">
      <div class="container-standard grid items-center gap-12 lg:grid-cols-[.9fr_1.1fr]">
        <div class="overflow-hidden rounded-3xl shadow-xl">
          <Image src={classroomImage} alt="學生在10教育3D創作課堂為打印作品加入顏色和細節" class="h-full min-h-96 w-full object-cover" widths={[640, 960]} sizes="(min-width: 1024px) 45vw, 100vw" />
        </div>
        <div>
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">學習成果</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">既學 AI，也學會對作品負責</h2>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            {outcomes.map(([title, description]) => (
              <article class="border-l-4 border-cyan-400 pl-4"><h3 class="font-bold">{title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{description}</p></article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section-padding bg-slate-50">
      <div class="container-standard">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">真實課堂與學生作品</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">由數碼建模，到打印和完成作品</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">學生在課堂中觀察和修改3D模型，再把打印作品加入顏色與個人化細節，完整經歷由構思到成品的創作過程。</p>
        </div>
        <div class="grid gap-6 lg:grid-cols-12">
          <figure class="overflow-hidden rounded-3xl bg-white shadow-sm lg:col-span-7">
            <Image src={modelingClassroomImage} alt="學生使用平板電腦進行3D數碼建模" class="aspect-[16/10] w-full object-cover" widths={[720, 1200]} sizes="(min-width: 1024px) 58vw, 100vw" />
            <figcaption class="p-5 font-semibold text-slate-700">在平板電腦上建立和調整3D模型</figcaption>
          </figure>
          <figure class="overflow-hidden rounded-3xl bg-white shadow-sm lg:col-span-5">
            <Image src={paintedCharacterImage} alt="學生為3D打印角色作品加入顏色和細節" class="aspect-[16/10] w-full object-cover object-center" widths={[640, 960]} sizes="(min-width: 1024px) 42vw, 100vw" />
            <figcaption class="p-5 font-semibold text-slate-700">為打印作品加入顏色和個人化細節</figcaption>
          </figure>
          <figure class="overflow-hidden rounded-3xl bg-white shadow-sm lg:col-span-12">
            <Image src={studentWorkImage} alt="10教育3D打印課堂的多款學生作品" class="aspect-[2/1] w-full object-cover object-center" widths={[768, 1280, 1920]} sizes="100vw" />
            <figcaption class="p-5 font-semibold text-slate-700">學生完成的3D打印作品</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section-padding bg-slate-100">
      <div class="container-standard">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">打印安排</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">使用學校設備，或由我們完成製作</h2>
        </div>
        <div class="grid gap-6 lg:grid-cols-2">
          <article class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">選項一</span>
            <h3 class="mt-5 text-2xl font-bold">使用學校的 3D 打印機</h3>
            <p class="mt-4 leading-7 text-slate-600">學校提供打印機、兼容線材和一般耗材。我們會事先確認打印機型號、切片軟件、多色配置和可用物料，再按實際設備控制作品大小和複雜程度。</p>
            <p class="mt-4 rounded-xl bg-amber-50 p-4 text-sm leading-6 text-amber-900">多色效果視乎學校打印機已安裝的供料系統和物料而定。</p>
          </article>
