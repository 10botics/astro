---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/course/HeroSection.astro';
import SingleCourseContent from '../../components/course/SingleCourseContent.astro';
import QnASection from '../../components/course/QnASection.astro';
import ContactSection from '../../components/ContactSection.astro';
import RelatedNews from '../../components/course/RelatedNews.astro';
import RelatedCourses from '../../components/course/RelatedCourses.astro';
import { Image } from 'astro:assets';

// Authentic student project screenshots
import studentSnake from '../../assets/images/school-courses/人工智能遊戲編程課程/student-work/student-snake-neon.png';
import studentSnakeGameplay from '../../assets/images/school-courses/人工智能遊戲編程課程/student-work/student-snake-gameplay.png';
import studentTowerDefense from '../../assets/images/school-courses/人工智能遊戲編程課程/student-work/student-tower-defense.png';
import studentChess from '../../assets/images/school-courses/人工智能遊戲編程課程/student-work/student-chess.png';

// Course data (static) - now in frontmatter
export const courseData = {
  title: "AI Vibe Coding 遊戲設計課程",
  subtitle: "2–4 小時完成可玩原型，或以 8–12 小時發展完整遊戲專題",
  tags: ["AI 人工智能", "Programming 編程", "遊戲開發", "高小", "中學"],
  videoId: "your-video-id-here",
  description: "為高小至中學而設的 AI Vibe Coding 遊戲設計課程。學生運用 AI coding 工具把創意轉化為可玩的網頁遊戲，內容與工具按程度及課時調整。",
  detailedDescription: "學生以自然語言與 AI coding 工具協作，把遊戲構思逐步轉化為可測試的網頁作品。兩至四小時工作坊以 Gemini 與 GitHub 集中完成可即場試玩的原型；八至十二小時進階課程則可使用 Codex 或 Cursor，加入更完整的企劃、邏輯、除錯、個人化及發布流程。課程適合高小至中學，內容按學生程度調整。",
  heroImage: studentSnakeGameplay
};

// Course curriculum
const curriculumItems = [
  {
    title: "AI Coding 入門：五子棋挑戰",
    content: [
      "討論遊戲本質（勝利條件、平衡性）",
      "學習如何把規則清楚描述給 AI",
      "使用 Gemini 生成單機版五子棋 HTML 原型",
      "要求 AI 加入難度選擇與 UI 美化"
    ]
  },
  {
    title: "專案企劃：創意發想環節",
    content: [
      "構思並創作屬於自己的項目",
      "觀察經典小遊戲（打磚塊、貪食蛇、2048、心理測驗）並分析適合網頁呈現的玩法",
      "撰寫遊戲說明書（玩家移動、分數計算、死亡機制等）",
      "與 Gemini 討論技術難點與實作建議"
    ]
  },
  {
    title: "專案實作（一）：核心框架",
    content: [
      "生成遊戲主要畫面與基本操作",
      "觀察遊戲行為並向 AI 反饋錯誤進行修改"
    ]
  },
  {
    title: "專案實作（二）：邏輯深度化",
    content: [
      "豐富規則（計分系統、多重關卡或遊戲結束機制）",
      "處理出現的 Bug（邏輯除錯練習）"
    ]
  },
  {
    title: "專案實作（三）：最終測試",
    content: [
      "功能完善（加入最高分紀錄等細節功能）",
      "最終測試（完整系統測試與穩定度除錯）"
    ]
  },
  {
    title: "GitHub 發佈與成果分享",
    content: [
      "建立儲存庫（Repository）與上傳程式碼",
      "啟動 GitHub Pages 取得個人專屬遊戲 URL",
      "作品介紹、互相試玩與評分"
    ]
  }
];

// Course highlights
const courseHighlights = [
  {
    icon: "fas fa-robot",
    title: "AI Coding 協作",
    description: "以自然語言與 Gemini、Codex 或 Cursor 等工具協作，把想法轉化為可測試的遊戲原型"
  },
  {
    icon: "fas fa-gamepad",
    title: "從原型到完整專案",
    description: "由五子棋起步，逐步完成企劃、框架、規則深化與最終測試，建立完整開發流程"
  },
  {
    icon: "fas fa-lightbulb",
    title: "提示工程與邏輯拆解",
    description: "重視早期思考與需求拆解，培養學生把問題轉化為有效 AI 指令的能力"
  },
  {
    icon: "fas fa-users",
    title: "創意與協作學習",
    description: "透過作品展示與互評，培養創意表達、溝通與持續改進能力"
  },
  {
    icon: "fas fa-globe",
    title: "GitHub 發佈能力",
    description: "學習使用 GitHub 管理與發佈專案，讓同學可透過專屬網址直接試玩作品"
  }
];

// Course requirements
const courseRequirements = [
  {
    icon: "fas fa-clock",
    title: "課時",
    description: "2–4 小時工作坊，或 8–12 小時進階課程"
  },
  {
    icon: "fas fa-laptop",
    title: "所需設備",
    description: "每位學生一部可連接互聯網及運行現代瀏覽器的手提電腦；不建議使用 iPad 或其他平板電腦"
  },
  {
    icon: "fas fa-user-graduate",
    title: "學員要求",
    description: "高小至中學，內容按學生程度調整"
  },
  {
    icon: "fas fa-sign-in-alt",
    title: "帳戶需求",
    description: "短版使用 Gemini 與 GitHub；進階課程可按校情使用 Codex 或 Cursor，帳戶安排於課前確認"
  }
];

// FAQ items
const faqItems = [
  {
    question: "零基礎學生可以參加嗎？",
    answer: "完全可以！本課程專為零基礎學生設計，使用 AI 工具讓編程變得簡單易懂。"
  },
  {
    question: "需要自備電腦嗎？",
    answer: "是的，每位學生需要使用一部可連接互聯網及運行現代瀏覽器的手提電腦，學校亦需提供穩定 Wi-Fi。iPad 或其他平板電腦不建議用於本課程。短版通常使用 Gemini 與 GitHub；進階課程可按校情使用 Codex 或 Cursor，實際帳戶安排會在課前確認。"
  },
  {
    question: "會學到什麼編程語言？",
    answer: "主要會接觸 HTML、CSS、JavaScript，並重點學習如何透過自然語言與 AI coding 工具協作、測試及改良作品。"
  },
  {
    question: "課程結束後能做出什麼作品？",
    answer: "短版工作坊會完成可在瀏覽器即場試玩的遊戲原型；進階課程可再加入個人化功能、完整測試及 GitHub Pages 發佈。"
  }
];


---

<Layout title={courseData.title} description={courseData.description}>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  
  <HeroSection 
    title={courseData.title}
    subtitle={courseData.subtitle}
    tags={courseData.tags}
    heroImage={courseData.heroImage}
    heroImageClass="scale-[1.55]"
    description={courseData.detailedDescription}
    parentSectionLabel="課程"
  />

  <section class="section-padding bg-white" aria-labelledby="vibe-coding-formats-heading">
    <div class="container-standard">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-bold tracking-[0.2em] text-brand-cyan-700">按課時選擇</p>
        <h2 id="vibe-coding-formats-heading" class="mt-3 text-3xl font-bold text-gray-900 md:text-4xl">每位學生都把想法變成可玩的作品</h2>
        <p class="mt-4 text-lg leading-8 text-gray-600">同一套創作流程可按學校時間表及學生程度調整，短課程重視完成原型，進階課程則深入測試、改良與發布。</p>
      </div>
      <div class="mx-auto mt-10 grid max-w-5xl gap-6 lg:grid-cols-2">
        <article class="rounded-2xl border-2 border-brand-cyan-500 bg-cyan-50 p-8">
          <p class="text-sm font-bold text-brand-cyan-700">集中創作體驗</p>
          <h3 class="mt-3 text-2xl font-bold text-gray-900">AI Vibe Coding 工作坊｜2–4 小時</h3>
          <p class="mt-4 leading-7 text-gray-700">學生拆解遊戲規則、向 Gemini 表達需求、測試並修正功能，再透過 GitHub 儲存或分享可即場試玩的網頁遊戲原型。</p>
          <p class="mt-5 rounded-xl bg-white p-4 font-semibold text-gray-900">適合課堂活動、試後活動及短期到校工作坊。</p>
        </article>
        <article class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
          <p class="text-sm font-bold text-brand-cyan-700">完整專題學習</p>
          <h3 class="mt-3 text-2xl font-bold text-gray-900">AI 遊戲創作專題｜8–12 小時</h3>
          <p class="mt-4 leading-7 text-gray-600">可使用 Codex 或 Cursor，由共同原型延伸至個人企劃，加入遊戲邏輯、關卡、介面、除錯、測試及作品發布。</p>
          <p class="mt-5 rounded-xl bg-gray-50 p-4 font-semibold text-gray-900">適合多節課程、課後活動及專題學習。</p>
        </article>
      </div>
      <div class="mx-auto mt-6 flex max-w-5xl flex-col items-start justify-between gap-5 rounded-2xl bg-slate-900 px-7 py-6 text-white md:flex-row md:items-center">
        <div>
          <h3 class="text-xl font-bold">高小至中學，內容按學生程度調整</h3>
          <p class="mt-2 text-slate-300">零編程基礎亦可參與；導師會按年級、打字能力及課時調整示範、遊戲複雜度與支援方式。</p>
        </div>
        <a href="#enquiry" class="inline-flex shrink-0 rounded-lg bg-brand-cyan-500 px-6 py-3 font-bold text-white hover:bg-brand-cyan-600">查詢到校安排</a>
      </div>
    </div>
  </section>

  <!-- Hero image and description section -->
  <section class="section-padding bg-white">
    <div class="container-standard">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="text-left lg:pl-4">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">為什麼選擇 AI 編程？</h2>
          <p class="text-lg text-gray-700 leading-relaxed mb-6">
            在 AI 原生時代，學生需要的不只是語法知識，更是把想法清楚表達、快速驗證與持續改良的能力。本課程按深度選用合適的 AI coding 工具，讓學生在遊戲專案中掌握需求表達、邏輯拆解與除錯流程，並建立可展示的實作成果。
          </p>
          <div class="space-y-4">
            <div class="flex items-start space-x-3">
              <i class="fas fa-check-circle text-brand-cyan-600 mt-1"></i>
              <span class="text-gray-700">以自然語言降低入門門檻，專注創意實現</span>
            </div>
            <div class="flex items-start space-x-3">
              <i class="fas fa-check-circle text-brand-cyan-600 mt-1"></i>
              <span class="text-gray-700">建立需求拆解與提示工程能力</span>
            </div>
            <div class="flex items-start space-x-3">
              <i class="fas fa-check-circle text-brand-cyan-600 mt-1"></i>
              <span class="text-gray-700">較長課程可完成 GitHub 發佈與成果分享</span>
            </div>
          </div>
        </div>
        <div class="justify-self-start">
          <a href="https://solverneos08.github.io/tower-defense/" target="_blank" rel="noopener noreferrer" class="group block overflow-hidden rounded-2xl bg-slate-950 shadow-xl">
            <Image
              src={studentTowerDefense}
              alt="學生創作的塔防網頁遊戲"
              width={600}
              height={400}
              class="aspect-[16/10] w-full object-cover object-center transition duration-300 group-hover:scale-[1.02]"
            />
            <div class="flex items-center justify-between gap-4 px-5 py-4 text-white">
              <div>
                <p class="text-xs font-bold tracking-[0.18em] text-cyan-300">真實學生作品</p>
                <p class="mt-1 font-bold">塔防遊戲：炮塔、波次與升級系統</p>
              </div>
              <i class="fas fa-arrow-up-right-from-square text-cyan-300"></i>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools by course depth section -->
  <section class="section-padding bg-gray-50">
    <div class="container-standard">
      <h2 class="text-3xl font-bold text-center mb-4 text-gray-800">按課程深度選用合適工具</h2>
      <p class="mx-auto mb-12 max-w-3xl text-center text-lg leading-8 text-gray-600">工具不是課程目的。我們會按課時、學生程度與學校帳戶環境，選擇足以支持學生完成作品的 AI coding 流程。</p>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="card-base card-hover p-6">
          <div class="flex items-center mb-4">
            <div class="w-8 h-8 bg-brand-cyan-600 rounded-full flex items-center justify-center mr-3">
              <i class="fas fa-brain text-sm text-white"></i>
            </div>
            <h3 class="text-xl font-semibold text-gray-800">Gemini 快速原型</h3>
          </div>
          <p class="text-gray-600">
            2–4 小時工作坊以 Gemini 快速生成、測試及修正網頁遊戲，讓學生在有限時間內完成可玩的成果。
          </p>
        </div>
        
        <div class="card-base card-hover p-6">
          <div class="flex items-center mb-4">
            <div class="w-8 h-8 bg-brand-cyan-600 rounded-full flex items-center justify-center mr-3">
              <i class="fas fa-cloud text-sm text-white"></i>
            </div>
            <h3 class="text-xl font-semibold text-gray-800">GitHub 儲存與分享</h3>
          </div>
          <p class="text-gray-600">
            短版可利用 GitHub 儲存及分享作品；較長課程則可進一步處理版本、發布及持續改良。
          </p>
        </div>
        
        <div class="card-base card-hover p-6">
          <div class="flex items-center mb-4">
            <div class="w-8 h-8 bg-brand-cyan-600 rounded-full flex items-center justify-center mr-3">
              <i class="fas fa-gamepad text-sm text-white"></i>
            </div>
            <h3 class="text-xl font-semibold text-gray-800">Codex／Cursor 進階開發</h3>
          </div>
          <p class="text-gray-600">
            8–12 小時進階課程可按校情使用 Codex 或 Cursor，讓學生處理較完整的檔案結構、功能迭代、除錯與個人專題。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Course requirements section -->
  <section class="section-padding bg-white">
    <div class="container-standard">
      <h2 class="text-3xl font-bold text-center mb-12 text-gray-800">課程要求</h2>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {courseRequirements.map((requirement) => (
          <div class="card-base card-hover p-6 text-center">
            <div class="w-12 h-12 bg-brand-cyan-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <i class={`${requirement.icon} text-xl text-white`}></i>
            </div>
            <h3 class="text-lg font-semibold text-gray-800 mb-2">{requirement.title}</h3>
            <p class="text-gray-600">{requirement.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Course highlights section -->
  <section class="section-padding bg-gray-50">
    <div class="container-standard">
      <h2 class="text-3xl font-bold text-center mb-12 text-gray-800">課程重點</h2>
      
      <div class="grid md:grid-cols-2 gap-8">
        {courseHighlights.map((highlight) => (
          <div class="card-base card-hover p-6">
            <div class="flex items-center mb-4">
              <div class="w-8 h-8 bg-brand-cyan-600 rounded-full flex items-center justify-center mr-3">
                <i class={`${highlight.icon} text-sm text-white`}></i>
              </div>
              <h3 class="text-lg font-semibold text-gray-800">{highlight.title}</h3>
            </div>
            <p class="text-gray-600">{highlight.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Authentic student work showcase -->
  <section class="section-padding bg-white" aria-labelledby="student-work-heading">
    <div class="container-standard">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-bold tracking-[0.2em] text-brand-cyan-700">真實學生作品</p>
        <h2 id="student-work-heading" class="mt-3 text-3xl font-bold text-gray-900 md:text-4xl">不只是練習，每個連結都可以真正試玩</h2>
        <p class="mt-4 text-lg leading-8 text-gray-600">學生由玩法構思開始，逐步加入電腦對戰、關卡、難度、升級系統及雙人模式。點擊作品即可開啟遊戲。</p>
      </div>

      <div class="mt-12 grid gap-7 lg:grid-cols-3">
        <a href="https://52110230608.github.io/snake/" target="_blank" rel="noopener noreferrer" class="group overflow-hidden rounded-2xl border-2 border-brand-cyan-400 bg-slate-950 shadow-lg lg:col-span-2">
          <Image src={studentSnake} alt="學生創作的霓虹貪食蛇遊戲" width={1200} height={675} class="aspect-video w-full object-cover object-center transition duration-300 group-hover:scale-[1.015]" />
          <div class="flex flex-col justify-between gap-4 p-6 text-white sm:flex-row sm:items-end">
            <div>
              <p class="text-xs font-bold tracking-[0.18em] text-cyan-300">遊戲介面與玩法設計</p>
              <h3 class="mt-2 text-2xl font-bold">Retro Neon Snake</h3>
              <p class="mt-2 text-slate-300">單人、電腦對戰及雙人模式，配合不同地圖、速度與視覺主題。</p>
            </div>
            <span class="inline-flex shrink-0 items-center font-bold text-cyan-300">立即試玩 <i class="fas fa-arrow-up-right-from-square ml-2 text-sm"></i></span>
          </div>
        </a>

        <div class="grid gap-7">
          <a href="https://solverneos08.github.io/tower-defense/" target="_blank" rel="noopener noreferrer" class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
            <Image src={studentTowerDefense} alt="學生創作的塔防遊戲" width={600} height={338} class="aspect-video w-full object-cover object-center transition duration-300 group-hover:scale-[1.02]" />
            <div class="p-5">
              <p class="text-xs font-bold tracking-[0.15em] text-brand-cyan-700">系統與策略</p>
              <h3 class="mt-2 text-xl font-bold text-gray-900">Tower Defense</h3>
              <p class="mt-2 text-sm leading-6 text-gray-600">炮塔選擇、敵人波次、升級與出售機制。</p>
            </div>
          </a>
          <a href="https://search-or-enter-website-name.github.io/hoi4-prototype/chess/" target="_blank" rel="noopener noreferrer" class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
            <Image src={studentChess} alt="學生創作的國際象棋遊戲" width={600} height={338} class="aspect-video w-full object-cover object-center transition duration-300 group-hover:scale-[1.02]" />
            <div class="p-5">
              <p class="text-xs font-bold tracking-[0.15em] text-brand-cyan-700">遊戲邏輯與電腦對戰</p>
              <h3 class="mt-2 text-xl font-bold text-gray-900">Chess</h3>
              <p class="mt-2 text-sm leading-6 text-gray-600">電腦對手、難度選擇及同機雙人模式。</p>
            </div>
          </a>
        </div>
      </div>

      <div class="mt-8 flex flex-col items-start justify-between gap-5 rounded-2xl bg-cyan-50 px-7 py-6 md:flex-row md:items-center">
        <p class="font-semibold leading-7 text-gray-800">以上均為課程學生作品；實際成果會因課時、學生程度及個人創作方向而有所不同。</p>
        <a href="https://alanchan246.github.io/AI_Vibe_Coding/showcase/index.html" target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center rounded-lg bg-brand-cyan-600 px-5 py-3 font-bold text-white hover:bg-brand-cyan-700">瀏覽更多作品 <i class="fas fa-arrow-up-right-from-square ml-2 text-sm"></i></a>
      </div>
    </div>
  </section>

