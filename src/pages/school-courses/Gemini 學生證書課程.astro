---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/course/HeroSection.astro';
import SingleCourseContent from '../../components/course/SingleCourseContent.astro';
import QnASection from '../../components/course/QnASection.astro';
import ContactSection from '../../components/ContactSection.astro';
import RelatedNews from '../../components/course/RelatedNews.astro';
import RelatedCourses from '../../components/course/RelatedCourses.astro';

import heroGeminiAiChat from '../../assets/images/school-courses/Gemini 學生證書課程/gallery-computer-lab-session.png';
import geminiStudentCertificate from '../../assets/images/school-courses/Gemini 學生證書課程/certificate-gemini-certified-student-sample.jpg';

export const courseData = {
  title: "Gemini 學生證書課程",
  subtitle: "2 小時完成認證路徑，或以 8 小時延伸至 NotebookLM 與 AI Vibe Coding",
  tags: [
    "AI 人工智能",
    "Google Gemini",
    "NotebookLM",
    "Programming 編程",
    "中學",
    "Google 認證"
  ],
  videoId: "your-video-id-here",
  description:
    "為香港學校而設的 Gemini 學生認證課程。13–17 歲學生可在導師帶領下完成 Google 基礎學習內容及官方考核；學校亦可選擇八小時版本，加入 NotebookLM 與 AI Vibe Coding 實作。",
  detailedDescription:
    "課程設有兩種到校安排：兩小時認證版本集中完成 Google 指定基礎學習內容、負責任使用 AI、重點溫習及官方考核；八小時進階版本則加入 NotebookLM 學習工具及 AI Vibe Coding 專題，讓學生在取得認證以外，完成更深入的應用與創作。",
  heroImage: heroGeminiAiChat
};

const courseHighlights = [
  {
    icon: "fas fa-wand-magic-sparkles",
    title: "Gemini 與生成式 AI 基礎",
    description:
      "認識生成式 AI 與 Google AI 工具願景，並實際操作 Gemini 平台核心能力，包含引導學習、影像生成、Canvas、深度研究與 Gems。"
  },
  {
    icon: "fas fa-book-reader",
    title: "NotebookLM 與延展學習體驗",
    description:
      "透過 Magic Door 試用與 NotebookLM 核心流程，體驗 Audio／Video Overview、心智圖、生字卡與測驗等，將閱讀與報告轉為可聽、可視化的學習內容。"
  },
  {
    icon: "fas fa-certificate",
    title: "官方認證與實作成果",
    description:
      "13–17 歲學生完成基礎學習及通過官方考核後，可取得 Google Gemini Certified Student 證書；八小時版本再加入個人遊戲專題。"
  }
];

const courseCurriculum = {
  items: [
    {
      title: "Gemini 學生認證路徑",
      duration: "2 小時",
      content: [
        "完成 Google 指定的 Gemini 基礎學習內容",
        "認識生成式 AI、Gemini 核心功能與負責任使用原則",
        "重點溫習、官方考核及提交支援"
      ]
    },
    {
      title: "NotebookLM",
      duration: "2 小時",
      content: [
        "Magic Door 試用",
        "NotebookLM 平台核心功能",
        "Audio Overview、Video Overview、MindMap、Flashcard、Quiz 等介紹與練習"
      ]
    },
    {
      title: "AI vibe coding",
      duration: "4 小時",
      content: [
        "以 AI 輔助規劃與實作程式邏輯",
        "建立自製五子棋",
        "延伸製作專屬主題小遊戲"
      ]
    }
  ]
};

const faqItems = [
  {
    question: "學校在課程中如何使用 NotebookLM？",
    answer: [
      "在到校課程中，我們會配合 Magic Door 試用——由本公司另外提供的方案，協助學校在既有的課程脈絡下安全、有節奏地導入 NotebookLM 相關體驗。",
      "更多方案說明可參考：https://www.magicdoor.cc/"
    ]
  },
  {
    question: "Gemini 學生證書對學生有什麼幫助？",
    answer: [
      "證書可作為學生完成 Google Gemini 學習路徑的正式紀錄，有助於他們在升學資料或學習歷程中展現具認證的 AI 素養。",
      "課程最後一段會集中完成考核步驟；若學生需額外支援，導師會於課堂內安排練習與答疑。"
    ]
  },
  {
    question: "小學生可以取得 Google Gemini 學生證書嗎？",
    answer: [
      "Google 的 K–12 Gemini Certified Student 官方考核只開放予 13–17 歲學生。未符合 Google 年齡要求的學生仍可參與按年齡調整的 Gemini AI 課程。",
      "完成課程後，本公司會向學生發出課程證書，但不會將其表述為 Google 官方認證。"
    ]
  },
  {
    question: "什麼年級與設備較適合？",
    answer: [
      "Google 官方認證版本適合 13–17 歲學生；小學生可參與按年齡調整的非官方認證版本。學生具備基本中英文打字與網頁操作能力更佳。",
      "學校請準備可上網的電腦或 Chromebook／手提電腦，並讓學生使用學校核准的 Google 帳戶登入相關服務。"
    ]
  }
];

---

<Layout title={courseData.title} description={courseData.description}>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  <main>
    <HeroSection
      title={courseData.title}
      subtitle={courseData.subtitle}
      description={courseData.detailedDescription}
      heroImage={courseData.heroImage}
      tags={courseData.tags}
      parentSectionLabel="課程"
    />

    <section class="section-padding bg-white" aria-labelledby="gemini-pathways-heading">
      <div class="container-standard">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-bold tracking-[0.2em] text-brand-cyan-700">兩種課程安排</p>
          <h2 id="gemini-pathways-heading" class="mt-3 text-3xl font-bold text-gray-900 md:text-4xl">由官方認證，延伸至真正的 AI 應用</h2>
          <p class="mt-4 text-lg leading-8 text-gray-600">學校可選擇集中完成認證的兩小時版本，或以八小時建立更完整的 Gemini、NotebookLM 與 AI 創作能力。</p>
        </div>
        <div class="mx-auto mt-10 grid max-w-5xl gap-6 lg:grid-cols-2">
          <article class="rounded-2xl border-2 border-brand-cyan-500 bg-cyan-50 p-8">
            <p class="text-sm font-bold text-brand-cyan-700">13–17 歲學生</p>
            <h3 class="mt-3 text-2xl font-bold text-gray-900">Gemini 學生認證｜約 2 小時</h3>
            <p class="mt-4 leading-7 text-gray-700">導師帶領學生完成 Google 指定基礎學習內容、認識負責任使用 AI 的原則、溫習重點並完成官方考核。</p>
            <p class="mt-5 rounded-xl bg-white p-4 font-semibold text-gray-900">通過考核後，學生可取得 Google Gemini Certified Student 證書。</p>
          </article>
          <article class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
            <p class="text-sm font-bold text-brand-cyan-700">完整應用與創作</p>
            <h3 class="mt-3 text-2xl font-bold text-gray-900">Gemini AI 進階課程｜約 8 小時</h3>
            <p class="mt-4 leading-7 text-gray-600">包含兩小時認證路徑，再加入 NotebookLM 學習工具，以及按學生進度安排 2–4 小時 AI Vibe Coding 專題。</p>
            <p class="mt-5 rounded-xl bg-gray-50 p-4 font-semibold text-gray-900">學生同時帶走官方認證、AI 學習方法與可實際操作的遊戲作品。</p>
          </article>
        </div>
        <div class="mx-auto mt-6 max-w-5xl rounded-2xl bg-slate-900 px-7 py-6 text-white md:flex md:items-center md:justify-between md:gap-8">
          <div>
            <h3 class="text-xl font-bold">小學生亦可參與 Gemini AI 課程</h3>
            <p class="mt-2 leading-7 text-slate-300">未符合 Google 年齡要求的學生會參與按年齡調整的學習任務；完成後由本公司發出課程證書，而非 Google 官方認證。</p>
          </div>
          <a href="#enquiry" class="mt-5 inline-flex shrink-0 rounded-lg bg-brand-cyan-500 px-6 py-3 font-bold text-white hover:bg-brand-cyan-600 md:mt-0">查詢到校安排</a>
        </div>
      </div>
    </section>

    <section class="section-padding bg-gray-50" aria-labelledby="gemini-student-certificate-heading">
      <div class="container-standard">
        <div class="text-center mb-10">
          <h2 id="gemini-student-certificate-heading" class="text-3xl font-bold text-gray-900 mb-4">
            Google 官方認證成果
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            13–17 歲學生完成 Google 指定基礎學習並通過官方考核後，可取得 Gemini Certified Student 認證。以下為證書範例。
          </p>
        </div>
        <div class="max-w-4xl mx-auto rounded-xl overflow-hidden shadow-xl ring-1 ring-gray-100 bg-gray-50">
          <Image
            src={geminiStudentCertificate}
            alt="Gemini Certified Student 證書範例（Google for Education），展示課程完成後可取得的認證樣式。"
            width={3574}
            height={2792}
            sizes="(min-width: 1024px) 896px, 100vw"
            class="w-full h-auto object-contain max-h-[85vh]"
          />
        </div>
      </div>
    </section>

    <section class="section-padding bg-slate-950 text-white" aria-labelledby="gemini-student-evidence-heading">
      <div class="container-standard grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-300">近期學校實踐</p>
          <h2 id="gemini-student-evidence-heading" class="mt-3 text-3xl font-bold md:text-4xl">學生在課堂內完成學習及認證流程</h2>
          <p class="mt-5 text-lg leading-8 text-slate-300">我們已在中學課堂帶領學生完成 Gemini 指定學習、應考準備及認證程序，參與學生成功取得 Google Gemini Certified Student 證書。</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-7">
          <p class="text-sm font-bold text-cyan-300">實際交付重點</p>
          <ul class="mt-5 space-y-4 text-slate-200">
            <li class="flex gap-3"><span class="text-cyan-300">✓</span><span>導師逐步帶領 Google 基礎學習內容</span></li>
            <li class="flex gap-3"><span class="text-cyan-300">✓</span><span>課堂內處理應考流程與技術支援</span></li>
            <li class="flex gap-3"><span class="text-cyan-300">✓</span><span>學生完成考核並取得官方證書</span></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section-padding bg-white">
      <div class="container-standard">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">課程亮點</h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {courseHighlights.map((item) => (
            <div class="card-base card-hover p-6">
              <div class="flex items-start">
                <div class="text-3xl text-brand-cyan-600 mr-4">
                  <i class={item.icon}></i>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900 mb-3">{item.title}</h3>
                  <p class="text-gray-600">{item.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SingleCourseContent
      items={courseCurriculum.items}
      hours="8 小時"
      hoursText="共"
      showAdjustmentNote={true}
      adjustmentText="可根據學校需要調整節數與模組比重"
      hoursFooterNote="以上為八小時進階版本；學校亦可選擇約兩小時的 Gemini 學生認證版本。"
    />

    <QnASection
      faqs={faqItems.map((item) => ({
        question: item.question,
        answer: item.answer.join("\n")
      }))}
    />

    <RelatedCourses
      courseTags={courseData.tags}
      courseTitle={courseData.title}
      currentCourseSlug="gemini-student-certificate"
      context="course"
    />

    <RelatedNews courseTags={courseData.tags} courseTitle={courseData.title} />

    <div id="enquiry" class="scroll-mt-20">
      <ContactSection
        interest="Gemini 學生認證到校課程"
        subtitle="告訴我們學生年級、人數、可用課時及 Google 帳戶安排，我們會建議兩小時認證版本或八小時進階課程，並提供方案及報價。"
      />
    </div>
  </main>
</Layout>
