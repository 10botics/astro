---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import dbsAuditorium from '../../assets/images/staff-development-day/ai-teacher-training/dbs-gemini-auditorium.jpg';
import dbsWorkshop from '../../assets/images/staff-development-day/ai-teacher-training/dbs-gemini-workshop.jpg';
import goodHopeWorkshop from '../../assets/images/staff-development-day/ai-teacher-training/good-hope-gemini-workshop.jpg';

const pageTitle = 'AI教師培訓及教師發展日｜Gemini Educator教師認證培訓｜10教育';
const pageDescription =
  '為香港學校提供AI教師培訓及教師發展日方案，涵蓋Gemini Educator認證、AI備課、教材製作、個人化學習、資訊素養、私隱及負責任使用AI。';
const pageKeywords =
  'AI教師培訓, 教師發展日, SDD, Gemini Educator, Gemini教師認證, 生成式AI, 資訊素養, 香港學校, 教師工作坊';
const whatsappHref = `/whatsapp?title=${encodeURIComponent('AI教師培訓及教師發展日')}&url=${encodeURIComponent(Astro.url.href)}`;

const outcomes = [
  {
    number: '01',
    title: '提升備課及日常工作效率',
    description: '運用Gemini整理資料、摘要、改寫、建立教材初稿、規劃活動及進行Deep Research。',
  },
  {
    number: '02',
    title: '設計互動及個人化學習',
    description: '透過Canvas、Guided Learning、Storybook及Gems，設計切合學生需要的學習內容。',
  },
  {
    number: '03',
    title: '建立AI及資訊素養',
    description: '辨識AI幻覺、核實資料來源、保護私隱，並建立師生負責任使用AI的原則。',
  },
  {
    number: '04',
    title: '準備Gemini Educator評核',
    description: '掌握認證所需的主要知識和實際應用，為Google的Gemini Certified Educator評核作好準備。',
  },
];

const formats = [
  { duration: '講座', title: '主題分享', description: '適合全校教師共同建立AI概念、資訊素養及校本方向。' },
  { duration: '約2小時', title: '實作培訓', description: '教師親自完成提示設計、備課、研究和教材製作任務。' },
  { duration: '半日', title: '教師發展日', description: '結合講解、示範、分組實作及校本應用討論。' },
  { duration: '全日', title: '深度工作坊', description: '按學校需要組合多個主題，並預留充足時間實踐和交流。' },
];

const topics = [
  'Gemini Educator教師認證培訓',
  'AI備課及教材製作',
  'AI教學及個人化學習',
  'AI研究及資料整理',
  '資訊素養與負責任使用AI',
  'AI校務及行政效率',
];

const faqs = [
  {
    question: '培訓適合哪些學校和教師？',
    answer: '課程適合香港中小學、特殊學校及教育機構，可按教師的AI經驗、學科背景和學校發展重點調整內容。',
  },
  {
    question: '教師發展日可以安排多長時間？',
    answer: '可安排主題講座、約兩小時實作培訓、半日或全日教師發展日，亦可按學校時間表度身設計。',
  },
  {
    question: '參與培訓是否一定取得Gemini Educator認證？',
    answer: '認證由Google頒發。培訓會協助教師掌握評核所需知識和應用，但教師仍須自行完成並通過Google評核。學校亦可選擇只參與培訓而不要求教師應考。',
  },
  {
    question: '內容可以配合學校需要嗎？',
    answer: '可以。我們會按參與教師、培訓目標、時間、學校現有工具及校本AI方向調整活動和示例。',
  },
  {
    question: '學校需要預先為每位教師購買付費AI帳戶嗎？',
    answer: '不需要另行為每位教師購買付費AI帳戶。參與教師只需備有學校提供的Google Workspace for Education帳戶。我們會在確認方案時了解學校現有帳戶和設備，並按可用功能設計培訓內容及事前準備。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} ogImage={dbsAuditorium.src}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-white text-slate-900">
    <header class="relative isolate overflow-hidden bg-slate-950 text-white">
      <Image
        src={dbsAuditorium}
        alt="拔萃男書院教師參與Gemini及生成式AI培訓"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
        widths={[640, 960, 1440, 2000]}
        sizes="100vw"
        loading="eager"
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-950 via-slate-950/90 to-slate-950/35"></div>
      <div class="container mx-auto px-4 py-20 md:py-28 lg:py-32">
        <div class="max-w-3xl">
          <p class="mb-5 inline-flex rounded-full border border-cyan-300/40 bg-cyan-300/10 px-4 py-2 text-sm font-semibold tracking-wide text-cyan-100">
            專為香港學校及教育機構設計
          </p>
          <h1 class="text-4xl font-bold leading-tight md:text-6xl lg:text-7xl">
            AI教師培訓<br />及教師發展日
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-100 md:text-xl">
            協助教師把Gemini及生成式AI真正應用於備課、教材製作、資料研究和個人化學習，同時建立資訊核實、私隱保障及負責任使用AI的能力。
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#enquiry" class="rounded-lg bg-cyan-400 px-7 py-4 text-center text-lg font-bold text-slate-950 shadow-lg transition hover:bg-cyan-300 focus:outline-none focus:ring-2 focus:ring-cyan-200">
              索取教師培訓方案
            </a>
            <a href="/staff-development-day/gemini-educator/" class="rounded-lg border-2 border-white/70 bg-white/10 px-7 py-4 text-center text-lg font-semibold text-white backdrop-blur transition hover:bg-white hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-white">
              了解Gemini Educator特訓班
            </a>
            <a href={whatsappHref} class="rounded-lg border-2 border-green-300/80 bg-green-500/20 px-7 py-4 text-center text-lg font-semibold text-white backdrop-blur transition hover:bg-green-500 focus:outline-none focus:ring-2 focus:ring-green-200">
              WhatsApp查詢
            </a>
          </div>
        </div>
      </div>
    </header>

    <section class="border-b border-slate-200 bg-slate-50 py-8">
      <div class="container mx-auto grid gap-5 px-4 text-center md:grid-cols-3 md:text-left">
        <div><p class="text-sm font-semibold text-cyan-700">校本設計</p><p class="mt-1 font-bold">配合教師經驗及學校發展方向</p></div>
        <div><p class="text-sm font-semibold text-cyan-700">實作為本</p><p class="mt-1 font-bold">不只聽講，教師即場完成應用任務</p></div>
        <div><p class="text-sm font-semibold text-cyan-700">認證準備</p><p class="mt-1 font-bold">旗艦Gemini Educator培訓方案</p></div>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-bold tracking-widest text-cyan-700">從日常工作到課堂實踐</p>
          <h2 class="mt-3 text-3xl font-bold md:text-5xl">
            學完即用，讓AI真正<span class="whitespace-nowrap">支援教學</span>
          </h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">課程內容源自我們實際為學校提供的Gemini教師培訓，按最新工具和香港教學情境持續更新。</p>
        </div>
        <div class="mx-auto mt-12 grid max-w-6xl gap-6 md:grid-cols-2">
          {outcomes.map((outcome) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
              <span class="text-sm font-bold text-cyan-700">{outcome.number}</span>
              <h3 class="mt-3 text-2xl font-bold">{outcome.title}</h3>
              <p class="mt-3 leading-7 text-slate-600">{outcome.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-slate-950 py-16 text-white md:py-24">
      <div class="container mx-auto grid items-center gap-12 px-4 lg:grid-cols-2">
        <div>
          <p class="text-sm font-bold tracking-widest text-cyan-300">旗艦教師培訓</p>
          <h2 class="mt-3 text-3xl font-bold md:text-5xl">Gemini Educator教師認證培訓</h2>
          <p class="mt-6 text-lg leading-8 text-slate-200">
            教師透過講解、示範及實作，掌握有效提示、Deep Research、Canvas、Guided Learning、Storybook、Gems及Google Classroom應用，並學習核實資料和安全使用AI。
          </p>
          <p class="mt-5 leading-7 text-slate-300">
            約兩小時完成核心培訓及認證評核準備。認證由Google頒發；教師須完成並通過Google評核，方可取得Gemini Certified Educator認證。
          </p>
          <a href="/staff-development-day/gemini-educator/" class="mt-8 inline-flex rounded-lg bg-cyan-400 px-6 py-3 font-bold text-slate-950 transition hover:bg-cyan-300">
            查看Gemini Educator培訓詳情
          </a>
        </div>
        <Image
          src={dbsWorkshop}
          alt="拔萃男書院教師在禮堂參與生成式AI實作培訓"
          class="aspect-[4/3] w-full rounded-2xl object-cover shadow-2xl"
          widths={[640, 960, 1400]}
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-bold tracking-widest text-cyan-700">培訓主題</p>
          <h2 class="mt-3 text-3xl font-bold md:text-5xl">
            不只教授工具，更協助學校建立<span class="whitespace-nowrap">應用能力</span>
          </h2>
        </div>
        <div class="mx-auto mt-10 flex max-w-5xl flex-wrap justify-center gap-3">
          {topics.map((topic) => <span class="rounded-full border border-cyan-200 bg-cyan-50 px-5 py-3 font-semibold text-cyan-950">{topic}</span>)}
        </div>
        <div class="mx-auto mt-12 grid max-w-6xl gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {formats.map((format) => (
            <article class="rounded-2xl bg-slate-50 p-6">
              <p class="font-bold text-cyan-700">{format.duration}</p>
              <h3 class="mt-2 text-xl font-bold">{format.title}</h3>
              <p class="mt-3 leading-7 text-slate-600">{format.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-cyan-50 py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-bold tracking-widest text-cyan-800">學校實例</p>
          <h2 class="mt-3 text-3xl font-bold md:text-5xl">香港學校的真實培訓經驗</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">我們按學校的教師背景、培訓目標和時間安排設計內容，讓參與者可以即場實踐。</p>
        </div>
        <div class="mx-auto mt-12 grid max-w-6xl gap-8 lg:grid-cols-2">
          <article class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <Image src={dbsAuditorium} alt="拔萃男書院教師在禮堂參與Gemini Educator培訓" class="aspect-video w-full object-cover" widths={[640, 960, 1400]} sizes="(min-width: 1024px) 50vw, 100vw" />
            <div class="p-7">
              <p class="text-sm font-bold text-cyan-700">拔萃男書院</p>
              <h3 class="mt-2 text-2xl font-bold">大規模Gemini Educator教師培訓</h3>
              <p class="mt-4 leading-7 text-slate-600">透過講解、現場示範及實作活動，協助教師掌握Gemini在備課、研究、教材製作及個人化學習方面的應用。多位參與教師其後完成Google評核並取得Gemini Certified Educator認證。</p>
            </div>
          </article>
          <article class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <Image src={goodHopeWorkshop} alt="德望學校教師分組參與Gemini實作培訓" class="aspect-video w-full object-cover" widths={[640, 960, 1400]} sizes="(min-width: 1024px) 50vw, 100vw" />
            <div class="p-7">
              <p class="text-sm font-bold text-cyan-700">德望學校</p>
              <h3 class="mt-2 text-2xl font-bold">AI教學應用實作培訓</h3>
              <p class="mt-4 leading-7 text-slate-600">教師透過實作認識Gemini的教學應用、提示設計、內容製作、資料核實及負責任使用AI，為日後參與Gemini Educator認證評核作好準備。</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="mx-auto max-w-4xl">
          <div class="text-center">
            <p class="text-sm font-bold tracking-widest text-cyan-700">常見問題</p>
            <h2 class="mt-3 text-3xl font-bold md:text-5xl">安排培訓前，學校通常會問</h2>
          </div>
          <div class="mt-10 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white px-6 md:px-8">
            {faqs.map((faq) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-5 text-lg font-bold">
                  {faq.question}<span aria-hidden="true" class="text-2xl text-cyan-700 transition group-open:rotate-45">＋</span>
                </summary>
                <p class="mt-4 max-w-3xl leading-7 text-slate-600">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="enquiry" class="scroll-mt-20 bg-slate-100 py-16 md:py-24">
      <div class="container mx-auto grid gap-10 px-4 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="text-sm font-bold tracking-widest text-cyan-700">下一步</p>
          <h2 class="mt-3 text-3xl font-bold md:text-5xl">索取AI教師培訓方案</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">告訴我們學校的培訓目標、預計人數和日期。我們會按需要建議主題、形式和時間安排。</p>
          <div class="mt-8 rounded-2xl bg-white p-6">
            <p class="font-bold">想先簡單談談？</p>
            <p class="mt-2 text-slate-600">您亦可直接透過WhatsApp聯絡我們。</p>
            <a href={whatsappHref} class="mt-4 inline-flex rounded-lg bg-green-600 px-5 py-3 font-bold text-white transition hover:bg-green-700">WhatsApp查詢</a>
          </div>
        </div>
        <div class="rounded-2xl bg-white p-6 shadow-sm md:p-8">
          <EnquiryForm variant="teacher-training" interest="AI教師培訓及教師發展日" />
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .container { max-width: 1200px; }
  html { scroll-behavior: smooth; }
</style>
