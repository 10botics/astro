---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';

import heroEventOverview from '../../assets/images/stemday/mainpage/hero-candidate-9500.jpg';
import classroomCoding from '../../assets/images/stemday/mainpage/IMG_0089-1024x768.jpg';
import classroomKsp from '../../assets/images/stemday/mainpage/WhatsApp-Image-2023-07-05-at-14.18.132-1024x768.jpeg';
import boothKeirin from '../../assets/images/stemday/hand-clap-keirin-race/hero-image.png';
import boothSpace from '../../assets/images/stemday/mainpage/virtual-space-station.png';
import boothDrone from '../../assets/images/stemday/mainpage/codrone-experience.png';
import boothMicrobit from '../../assets/images/stemday/mainpage/microbit-car.png';
import newsHolimLai from '../../assets/images/news/2025-07-19-可立中學ai藝術創作stem-day精彩回顧/featured.jpg';
import newsTinHong from '../../assets/images/news/2024-07-10-深度探索Delightex-vrampar浸信會天虹小學-stem-day/image1.png';
import newsYmca from '../../assets/images/stemday/mainpage/ai-digital-animation.png';

const formats = [
  {
    number: '01',
    title: '課室工作坊',
    eyebrow: '人人動手創作',
    description: '學生在課室內同步參與，從構思、實作到展示，在有限時間內完成可見的學習成果。',
    meta: '一般 60–180 分鐘一節，可安排平行課堂',
    href: '#classroom-workshops'
  },
  {
    number: '02',
    title: '體驗攤位',
    eyebrow: '流動探索科技',
    description: '以短時間、低門檻的互動體驗營造全校科技氣氛，適合禮堂、操場或多用途空間。',
    meta: '按場地、人流與活動時段配置',
    href: '#experience-booths'
  },
  {
    number: '03',
    title: '專題講座',
    eyebrow: '用故事打開視野',
    description: '從人工智能、太空科技到區塊鏈，以貼近學生的案例把科技發展連結社會與未來。',
    meta: '一般 45–60 分鐘，可配合互動問答',
    href: '#talks'
  }
];

const featuredWorkshops = [
  {
    title: 'AI 影片創作',
    badge: '高小至中學',
    description: '運用 Gemini 構思故事、生成畫面，再以 Canva 組合成短片，讓學生帶走可播放的作品。',
    outcome: '成果：AI 故事短片／分鏡作品',
    href: '/school-courses/AI 影片製作課程入門'
  },
  {
    title: 'AI Vibe Coding',
    badge: '中學',
    description: '學生以自然語言與 Gemini 協作，在 85–180 分鐘內設計、測試並改良個人網頁遊戲。',
    outcome: '成果：可即場試玩的遊戲原型',
    href: '/school-courses/人工智能遊戲編程課程'
  },
  {
    title: 'Gemini 學生證書路徑',
    badge: '高小至中學',
    description: '以 2–4 小時認識 Gemini、NotebookLM 與負責任使用 AI，作為完整八小時認證課程的起點。',
    outcome: '成果：AI 學習任務；證書須完成完整八小時課程',
    href: '/school-courses/Gemini 學生證書課程'
  }
];

const additionalWorkshops = [
  ['KSP 太空任務', '/school-courses/ksp太空計劃課程'],
  ['CoSpaces／Delightex 3D 創作', '/school-courses/Delightex 遊戲設計課程'],
  ['AI 藝術創作', '/school-courses/AI藝術創作課程'],
  ['無人機編程與挑戰', '/school-courses/Tello 無人機課程'],
  ['Micro:bit 創作', '/school-courses/Microbit 降落傘課程'],
  ['科學手作與工程挑戰', '/stemday/DIY 手作']
];

const booths = [
  { title: '手拍凱林賽', description: '以節奏與反應控制單車競速', image: boothKeirin, href: '/stemday/手拍凱林賽' },
  { title: '虛擬太空站接駁', description: '完成沉浸式太空對接任務', image: boothSpace, href: '/stemday/虛擬太空站接駁任務' },
  { title: '無人機挑戰', description: '體驗飛行控制與任務操作', image: boothDrone, href: '/stemday/無人機足球' },
  { title: 'Micro:bit 足球車', description: '操控、競賽與工程思維並重', image: boothMicrobit, href: '/stemday/Microbit 足球車競賽' }
];

const talks = [
  {
    title: 'AI、未來交通與自動駕駛',
    description: '從生成式 AI 到自動駕駛，認識人工智能如何理解環境、作出判斷，以及科技帶來的社會與倫理議題。',
    audience: '高小及中學'
  },
  {
    title: '太空科技、火箭與人類探索',
    description: '由可重用火箭、月球與火星任務出發，理解太空工程如何改變人類探索宇宙的方法。',
    audience: '高小及中學'
  },
  {
    title: '區塊鏈與智能合約入門',
    description: '以數碼素養角度認識去中心化、區塊鏈紀錄及智能合約，不涉及投資推介。',
    audience: '中學生'
  }
];

const cases = [
  {
    date: '2025',
    title: '可立中學｜AI 藝術創作 STEM Day',
    description: '學生在課室內由概念出發，運用生成式 AI 完成個人視覺創作。',
    image: newsHolimLai,
    href: '/news/2025-07-19-可立中學ai藝術創作stem-day精彩回顧'
  },
  {
    date: '2024',
    title: '浸信會天虹小學｜VR／AR 科技體驗',
    description: '以多元互動體驗讓學生探索沉浸式科技及其實際應用。',
    image: newsTinHong,
    href: '/news/2024-07-10-深度探索cospaces-vrampar浸信會天虹小學-stem-day'
  },
  {
    date: '2024',
    title: '中華基督教青年會中學｜AI 與數碼動畫',
    description: '把人工智能、動畫創作與科技體驗帶進校園活動。',
    image: newsYmca,
    href: '/news/2024-07-05-ai科技與創意融合中華基督教青年會中學-stem-day'
  }
];

const faqs = [
  ['學校只有兩至四小時，可以怎樣安排？', '大部分 STEM Day 都可在 2–4 小時內完成。我們會按年級、人數及場地，安排一至多節 60–180 分鐘工作坊、體驗攤位或講座。'],
  ['可以同時安排不同活動嗎？', '可以。課室工作坊、體驗攤位與講座可按學校需要組合；我們會協助規劃人流、平行課堂、轉場及器材。'],
  ['課室工作坊是否每位學生都有作品？', '活動會按時數設定合適成果，例如短片、遊戲原型、AI 藝術作品、任務紀錄或學習成果。實際完成程度亦取決於學生年級、設備及帳戶設定。'],
  ['Gemini 體驗課完成後會取得證書嗎？', '2–4 小時 STEM Day 版本屬探索或預備模組，不會直接頒發認證。學生須完成完整八小時課程及相關考核，才可取得 Gemini 學生證書。'],
  ['學校需要準備甚麼？', '一般需要場地、投影設備及穩定網絡；部分工作坊需要學生電腦、平板或獲學校核准的 Google 帳戶。我們會在確認方案後提供完整準備清單。']
];
---

<Layout
  title="STEM Day 到校活動｜課室工作坊、體驗攤位及專題講座"
  description="10教育為香港中小學設計 2–4 小時 STEM Day，提供課室工作坊、科技體驗攤位及專題講座，讓學生由體驗走向創作，帶走作品、能力或認證。"
>
  <main class="bg-white text-slate-900">
    <section class="relative isolate overflow-hidden bg-slate-950 text-white">
      <Image
        src={heroEventOverview}
        alt="學校禮堂內多組學生同時參與 STEM Day 科技活動"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-950 via-slate-950/90 to-slate-950/20"></div>
      <div class="container-standard py-24 md:py-32 lg:py-36">
        <div class="max-w-3xl">
          <p class="mb-5 text-sm font-bold tracking-[0.24em] text-cyan-300">到校 STEM DAY</p>
          <h1 class="text-4xl font-bold leading-tight md:text-6xl">由體驗走向創作</h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-200">按學生年級、時間、場地與預算，設計課室工作坊、體驗攤位及專題講座。活動不只熱鬧，更讓學生真正參與、思考與完成成果。</p>
          <div class="mt-9 flex flex-wrap gap-4">
            <a href="#contact-form" class="rounded-lg bg-cyan-400 px-7 py-3.5 font-bold text-slate-950 transition hover:bg-cyan-300">索取報價</a>
            <a href="#programme-formats" class="rounded-lg border border-white/40 bg-white/10 px-7 py-3.5 font-semibold text-white backdrop-blur transition hover:bg-white/20">了解活動形式</a>
          </div>
        </div>
      </div>
    </section>

    <section aria-label="STEM Day 活動經驗" class="border-b border-slate-200 bg-white">
      <div class="container-standard py-10 md:py-12">
        <div class="grid gap-8 text-center md:grid-cols-3 md:divide-x md:divide-slate-200">
          <div>
            <p class="text-4xl font-black text-cyan-700 md:text-5xl">90<span class="ml-1 text-xl md:text-2xl">場</span></p>
            <p class="mt-2 font-bold text-slate-900">STEM／STEAM Day</p>
            <p class="mt-1 text-sm text-slate-500">累積策劃及到校執行</p>
          </div>
          <div>
            <p class="text-4xl font-black text-cyan-700 md:text-5xl">60<span class="ml-1 text-xl md:text-2xl">間</span></p>
            <p class="mt-2 font-bold text-slate-900">學校及機構</p>
            <p class="mt-1 text-sm text-slate-500">涵蓋不同年級及學習需要</p>
          </div>
          <div>
            <p class="text-4xl font-black text-cyan-700 md:text-5xl">48<span class="ml-1 text-xl md:text-2xl">場</span></p>
            <p class="mt-2 font-bold text-slate-900">於 2025–2026 年完成</p>
            <p class="mt-1 text-sm text-slate-500">持續更新活動內容與科技主題</p>
          </div>
        </div>
      </div>
    </section>

    <section id="programme-formats" class="section-padding bg-slate-50">
      <div class="container-standard">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">三種活動形式，同樣重要</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">按學校目標，組成合適的 STEM Day</h2>
          <p class="mt-4 text-lg leading-8 text-slate-600">學校可選擇單一形式，亦可按時間表、場地與預算靈活配搭。</p>
        </div>
        <div class="grid gap-6 lg:grid-cols-3">
          {formats.map((format) => (
            <a href={format.href} class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-cyan-300 hover:shadow-xl">
              <div class="flex items-center justify-between"><span class="text-sm font-bold tracking-widest text-cyan-700">{format.eyebrow}</span><span class="text-3xl font-black text-slate-200">{format.number}</span></div>
              <h3 class="mt-5 text-2xl font-bold">{format.title}</h3>
              <p class="mt-4 flex-1 leading-7 text-slate-600">{format.description}</p>
              <p class="mt-6 border-t border-slate-100 pt-5 text-sm font-semibold text-slate-700">{format.meta}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="classroom-workshops" class="section-padding bg-white scroll-mt-24">
      <div class="container-standard">
        <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_.95fr]">
          <div>
            <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">課室工作坊</p>
            <h2 class="mt-3 text-3xl font-bold md:text-4xl">人人參與，從想法走到作品</h2>
            <p class="mt-5 text-lg leading-8 text-slate-600">學生毋須輪候短暫體驗，而是在導師引導下同步動手。一般可把現有完整課程濃縮成 60–180 分鐘的主題工作坊，亦可安排多個課室平行進行。</p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <Image src={classroomCoding} alt="學生在課室內進行 AI 創作活動" class="h-56 w-full rounded-2xl object-cover" />
            <Image src={classroomKsp} alt="學生參與 KSP 太空任務工作坊" class="mt-8 h-56 w-full rounded-2xl object-cover" />
          </div>
        </div>

        <div class="mt-14 grid gap-6 lg:grid-cols-3">
          {featuredWorkshops.map((workshop) => (
            <article class="flex h-full flex-col rounded-2xl bg-slate-950 p-7 text-white">
              <span class="w-fit rounded-full bg-cyan-400/15 px-3 py-1 text-xs font-bold text-cyan-300">{workshop.badge}</span>
              <h3 class="mt-5 text-2xl font-bold">{workshop.title}</h3>
              <p class="mt-4 flex-1 leading-7 text-slate-300">{workshop.description}</p>
              <p class="mt-5 text-sm font-semibold text-cyan-200">{workshop.outcome}</p>
              <a href={workshop.href} class="mt-6 inline-flex font-bold text-white hover:text-cyan-300">查看課程詳情 <span aria-hidden="true" class="ml-2">→</span></a>
            </article>
          ))}
        </div>

        <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-7 md:p-9">
          <h3 class="text-xl font-bold">更多可濃縮成 STEM Day 的主題</h3>
          <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {additionalWorkshops.map(([title, href]) => (
              <a href={href} class="rounded-xl border border-slate-200 bg-white px-5 py-4 font-semibold text-slate-800 transition hover:border-cyan-400 hover:text-cyan-800">{title} <span aria-hidden="true">→</span></a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="experience-booths" class="section-padding bg-cyan-50 scroll-mt-24">
      <div class="container-standard">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">體驗攤位</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">讓科技走進校園每個角落</h2>
          <p class="mt-4 text-lg leading-8 text-slate-600">適合希望營造全校氣氛、讓不同年級自由探索的學校。我們會按場地、人流及活動時段，選擇互動清晰、容易投入的科技體驗。</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {booths.map((booth) => (
            <a href={booth.href} class="group overflow-hidden rounded-2xl bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
              <Image src={booth.image} alt={`${booth.title} STEM Day 體驗`} class="h-52 w-full object-cover transition duration-500 group-hover:scale-105" />
              <div class="p-6"><h3 class="text-xl font-bold">{booth.title}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{booth.description}</p></div>
            </a>
          ))}
        </div>
        <p class="mt-8 text-center text-sm text-slate-600">另有 VR／AR、反應挑戰、模擬駕駛、Apple Vision Pro、機械人及科學手作等選項；實際供應按日期、場地與人手安排確認。</p>
      </div>
    </section>

    <section id="talks" class="section-padding bg-slate-950 text-white scroll-mt-24">
      <div class="container-standard">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-300">專題講座｜45–60 分鐘</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">由一個好問題，打開科技世界</h2>
          <p class="mt-4 text-lg leading-8 text-slate-300">以故事、案例和互動提問，把艱深科技連結學生的生活、社會與未來。</p>
        </div>
        <div class="grid gap-6 lg:grid-cols-3">
          {talks.map((talk, index) => (
            <article class="rounded-2xl border border-white/10 bg-white/5 p-7">
              <span class="text-sm font-bold text-cyan-300">主題 {String(index + 1).padStart(2, '0')}｜{talk.audience}</span>
              <h3 class="mt-5 text-2xl font-bold">{talk.title}</h3>
              <p class="mt-4 leading-7 text-slate-300">{talk.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-padding bg-white">
      <div class="container-standard">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">學校活動實例</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">不同場景，同樣讓學生投入</h2>
          <p class="mt-4 text-lg leading-8 text-slate-600">由單次主題活動到年度科技日，不少學校再次委託我們策劃，按每年學生需要、場地與科技發展更新內容。</p>
        </div>
        <div class="grid gap-6 lg:grid-cols-3">
          {cases.map((item) => (
            <a href={item.href} class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
              <Image src={item.image} alt={item.title} class="h-56 w-full object-cover transition duration-500 group-hover:scale-105" />
              <div class="p-6"><span class="text-xs font-bold text-cyan-700">{item.date}</span><h3 class="mt-2 text-xl font-bold">{item.title}</h3><p class="mt-3 leading-7 text-slate-600">{item.description}</p><span class="mt-5 inline-flex font-bold text-cyan-800">閱讀活動回顧 →</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section-padding bg-slate-50" aria-labelledby="stem-day-video-heading">
      <div class="container-standard">
        <div class="mx-auto mb-10 max-w-3xl text-center">
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">過往活動實錄</p>
          <h2 id="stem-day-video-heading" class="mt-3 text-3xl font-bold md:text-4xl">STEM Day 校園實況</h2>
          <p class="mt-4 text-lg leading-8 text-slate-600">透過過往活動片段，了解學生在真實校園環境中參與科技體驗的情況。</p>
        </div>
        <div class="mx-auto max-w-5xl overflow-hidden rounded-2xl bg-slate-950 shadow-2xl">
          <div class="aspect-video">
            <iframe
              src="https://www.youtube.com/embed/qs5OeXSTzsY"
              title="10教育過往 STEM Day 校園活動實錄"
              class="h-full w-full"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <section class="section-padding bg-slate-50">
      <div class="container-standard grid gap-12 lg:grid-cols-[.8fr_1.2fr]">
        <div><p class="text-sm font-bold tracking-[0.2em] text-cyan-700">活動策劃</p><h2 class="mt-3 text-3xl font-bold">由學校條件出發</h2><p class="mt-5 leading-8 text-slate-600">告訴我們年級、人數、日期、時段、場地及預算方向，我們會建議合適的課堂、攤位或講座組合，並列出器材、帳戶及場地準備。</p></div>
        <div class="space-y-3">
          {faqs.map(([question, answer]) => (
            <details class="group rounded-xl border border-slate-200 bg-white p-5"><summary class="cursor-pointer list-none pr-8 font-bold marker:hidden">{question}<span class="float-right text-cyan-700 group-open:rotate-45">＋</span></summary><p class="mt-4 border-t border-slate-100 pt-4 leading-7 text-slate-600">{answer}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section id="contact-form" class="section-padding scroll-mt-24 bg-gradient-to-br from-cyan-50 to-slate-100">
      <div class="container-standard grid items-start gap-10 lg:grid-cols-[.75fr_1.25fr]">
        <div class="lg:sticky lg:top-28"><p class="text-sm font-bold tracking-[0.2em] text-cyan-700">下一步</p><h2 class="mt-3 text-3xl font-bold md:text-4xl">索取 STEM Day 報價</h2><p class="mt-5 text-lg leading-8 text-slate-600">提供初步日期、人數與活動時間即可。我們會按學校需要建議活動內容、場地配置及預算方案。</p><p class="mt-6 rounded-xl bg-white p-5 text-sm leading-6 text-slate-600 shadow-sm">一般 STEM Day 為 2–4 小時。活動可選課室工作坊、體驗攤位或專題講座，亦可按需要配搭。</p></div>
        <div class="rounded-2xl bg-white p-6 shadow-xl md:p-9"><EnquiryForm interest="STEM Day 到校活動及報價" /></div>
      </div>
    </section>
  </main>
</Layout>
