---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';

import heroAuditorium from '../../assets/images/news/2025-04-16-活動回顧10教育成功在順德聯誼總會李金小學舉辦國家安全講座/image1.jpeg';
import primaryAudience from '../../assets/images/news/2025-03-31-活動回顧讓孩子了解人工智能與國家安全講座/image1.jpeg';
import secondaryStage from '../../assets/images/news/2025-01-03-國家安全教育學生講座-聚焦人工智能安全/image1.jpeg';

const pageTitle = '中小學 AI 學生講座及未來科技到校講座｜10教育';
const pageDescription = '10教育為香港中小學提供45–60分鐘AI與未來科技學生講座，涵蓋人工智能素養、資訊安全、無人駕駛、太空科技、區塊鏈及國家安全教育，可按年級與校本需要調整。';
const pageKeywords = 'AI講座,人工智能講座,人工智能素養學生講座,學生講座,到校講座,STEM講座,未來科技講座,資訊素養講座,國家安全教育講座,香港中小學';

const talks = [
  {
    number: '01',
    title: '人工智能、未來交通與無人駕駛',
    audience: '高小及中學',
    summary: '從人工智能的基本概念出發，認識無人駕駛如何感知環境和作出判斷，並探討相關的安全、倫理、就業與社會影響。',
    points: ['人工智能如何學習與判斷', '無人駕駛的感知與決策', '安全、倫理、就業及社會影響'],
    accent: 'from-cyan-500 to-blue-600',
  },
  {
    number: '02',
    title: '太空科技、火箭與人類探索',
    audience: '高小及中學',
    summary: '從可重用火箭、太空工程，以及月球和火星任務，認識科技創新如何改變人類探索太空的方式。',
    points: ['火箭為何能夠進入太空', '可重用火箭與太空工程', '月球、火星與未來太空探索'],
    accent: 'from-violet-500 to-indigo-700',
  },
  {
    number: '03',
    title: '區塊鏈、智能合約與數碼安全',
    audience: '中學生',
    summary: '從數碼素養角度認識區塊鏈紀錄、智能合約、數碼擁有權與網上信任，並學習辨識常見的網絡詐騙。',
    points: ['區塊鏈如何保存和驗證紀錄', '智能合約與數碼擁有權', '網上信任、風險及詐騙辨識'],
    accent: 'from-amber-400 to-orange-600',
  },
  {
    number: '04',
    title: 'AI、資訊安全與國家安全',
    audience: '高小及中學',
    summary: '從學生熟悉的 AI 應用出發，認識個人資料、網絡安全、假資訊及負責任使用科技，並理解科技使用與國家安全的關係。',
    points: ['AI 應用與潛在風險', '個人資料、網絡及資訊安全', '假資訊、科技責任與國家安全'],
    accent: 'from-emerald-500 to-teal-700',
  },
];

const arrangements = [
  { title: '45–60 分鐘', description: '包括主題講解、科技案例、互動提問及簡短問答環節。' },
  { title: '按年級調整', description: '語言、案例和討論深度會配合高小、初中或高中學生。' },
  { title: '適合全級或全校', description: '可在禮堂、演講廳或多用途空間進行，亦可分級安排多場。' },
  { title: '配合校本重點', description: '可按學校關注的主題、活動背景和可用時間調整內容重點。' },
];

const evidence = [
  {
    title: '順德聯誼總會李金小學',
    label: '人工智能與國家安全講座',
    description: '以貼近小學生的故事和互動方式，認識人工智能、資訊安全與負責任使用科技。',
    image: heroAuditorium,
    href: '/news/2025-04-16-活動回顧10教育成功在順德聯誼總會李金小學舉辦國家安全講座',
  },
  {
    title: '順德聯誼總會胡少渠紀念小學',
    label: '人工智能與國家安全講座',
    description: '按學生年齡安排兩場講座，以趣味提問連結日常科技與安全意識。',
    image: primaryAudience,
    href: '/news/2025-03-31-活動回顧讓孩子了解人工智能與國家安全講座',
  },
  {
    title: '仁濟醫院靚次伯紀念中學',
    label: '國家安全教育學生講座',
    description: '由 AI 技術應用延伸至數據安全、網絡風險、法律與道德責任。',
    image: secondaryStage,
    href: '/news/2025-01-03-國家安全教育學生講座-聚焦人工智能安全',
  },
];

const faqs = [
  {
    question: '學生講座適合哪些年級？',
    answer: '人工智能與無人駕駛、太空科技，以及AI與資訊安全主題適合高小至中學；區塊鏈與智能合約主題主要為中學生設計。我們會按學生年齡調整用語、案例與討論深度。',
  },
  {
    question: '一場到校講座需要預留多少時間？',
    answer: '標準安排為45–60分鐘，包括主題講解、互動提問及簡短問答環節。學校亦可按時間表安排同日多場或分級講座。',
  },
  {
    question: '學校需要準備甚麼？',
    answer: '一般需要投影機或大型顯示屏，以及適合場地人數的咪高峰和音響設備。學校需安排一位聯絡人協助場地安排、設備測試及學生進場。',
  },
  {
    question: '講座內容可以配合學校主題調整嗎？',
    answer: '可以。我們會先了解學生年級、學校關注的主題、活動背景及可用時間，再調整案例、互動問題和內容重點。',
  },
  {
    question: '可以同日為不同年級安排多場講座嗎？',
    answer: '可以。學校可按禮堂容量、級別和時間表安排多場，並為不同年級選擇不同主題或深度。',
  },
  {
    question: '學生講座可以加入 STEM Day 嗎？',
    answer: '可以。講座可獨立舉行，亦可作為 STEM Day 其中一個環節，與課室工作坊或科技體驗配合。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} ogImage={heroAuditorium.src}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-white text-slate-900">
    <header class="relative isolate overflow-hidden bg-slate-950 text-white">
      <Image
        src={heroAuditorium}
        alt="全校學生在禮堂參與人工智能及國家安全講座"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-950 via-slate-950/90 to-slate-950/25"></div>
      <div class="container-standard py-24 md:py-32 lg:py-36">
        <div class="max-w-3xl">
          <p class="mb-5 inline-flex rounded-full border border-cyan-300/40 bg-slate-950/50 px-4 py-2 text-sm font-bold tracking-wide text-cyan-200 backdrop-blur">
            中小學到校講座｜45–60 分鐘
          </p>
          <h1 class="text-4xl font-bold leading-tight md:text-6xl">AI 與未來科技<br />學生講座</h1>
          <p class="mt-7 max-w-2xl break-words text-lg leading-8 text-slate-100 md:text-xl">從人工智能與資訊素養出發，讓學生看懂科技如何改變生活、社會與未來。</p>
          <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
            <a href="#contact-form" class="rounded-lg bg-cyan-400 px-7 py-3.5 text-center font-bold text-slate-950 transition hover:bg-cyan-300">索取講座資料及報價</a>
            <a href="#talk-topics" class="rounded-lg border border-white/40 bg-white/10 px-7 py-3.5 text-center font-semibold text-white backdrop-blur transition hover:bg-white/20">查看講座主題</a>
          </div>
        </div>
      </div>
    </header>

    <section class="border-b border-slate-200 bg-white">
      <div class="container-standard grid gap-6 py-8 text-center sm:grid-cols-3 sm:divide-x sm:divide-slate-200">
        <div><p class="text-2xl font-black text-cyan-700">45–60 分鐘</p><p class="mt-1 text-sm text-slate-600">容易配合學校時間表</p></div>
        <div><p class="text-2xl font-black text-cyan-700">高小至中學</p><p class="mt-1 text-sm text-slate-600">內容按學生程度調整</p></div>
        <div><p class="text-2xl font-black text-cyan-700">講解＋互動</p><p class="mt-1 text-sm text-slate-600">以案例和問題帶動思考</p></div>
      </div>
    </section>

    <section id="talk-topics" class="section-padding scroll-mt-24 bg-slate-50">
      <div class="container-standard">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">四個學生講座主題</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">從科技原理出發，認識科技對生活與社會的影響</h2>
          <p class="mt-4 text-lg leading-8 text-slate-600">每個主題均可獨立安排。我們會按學生年級、學校關注的主題與活動背景，調整內容和互動問題。</p>
        </div>
        <div class="grid gap-6 lg:grid-cols-2">
          {talks.map((talk) => (
            <article class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-7 shadow-sm md:p-9">
              <div class={`absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r ${talk.accent}`}></div>
              <div class="flex items-start justify-between gap-5">
                <span class="text-sm font-black tracking-[0.18em] text-cyan-700">主題 {talk.number}</span>
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">{talk.audience}</span>
              </div>
              <h3 class="mt-5 text-2xl font-bold md:text-3xl">{talk.title}</h3>
              <p class="mt-4 leading-7 text-slate-600">{talk.summary}</p>
              <ul class="mt-6 space-y-3 border-t border-slate-100 pt-6">
                {talk.points.map((point) => <li class="flex gap-3 text-sm font-semibold text-slate-700"><span class="text-cyan-600">✓</span>{point}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <p class="mx-auto mt-8 max-w-3xl text-center text-sm leading-6 text-slate-500">區塊鏈主題以科技認知和數碼安全為重點，不涉及投資推介或加密貨幣交易操作。</p>
      </div>
    </section>

    <section class="section-padding bg-white">
      <div class="container-standard grid items-center gap-12 lg:grid-cols-[.9fr_1.1fr]">
        <div>
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">講座形式</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">從科技案例出發，引導學生思考</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">講者透過故事、影片、生活例子、科技案例和互動提問，把抽象概念連結學生熟悉的日常生活。講座亦設簡短問答環節，鼓勵學生提出自己的問題。</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {arrangements.map((item) => (
            <article class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
              <h3 class="text-xl font-bold">{item.title}</h3>
              <p class="mt-3 leading-7 text-slate-600">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-padding bg-cyan-50">
      <div class="container-standard">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">過往學生講座</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">具備小學及中學到校講座經驗</h2>
          <p class="mt-4 text-lg leading-8 text-slate-600">我們會按學生年齡、場地安排及學校教育重點，調整講解方式、案例深度與互動節奏。</p>
        </div>
        <div class="grid gap-6 lg:grid-cols-3">
          {evidence.map((item) => (
            <a href={item.href} class="group overflow-hidden rounded-2xl bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
              <Image src={item.image} alt={`${item.title}${item.label}`} class="h-56 w-full object-cover transition duration-500 group-hover:scale-105" widths={[480, 768]} sizes="(min-width: 1024px) 33vw, 100vw" />
              <div class="p-6">
                <p class="text-xs font-bold text-cyan-700">{item.label}</p>
                <h3 class="mt-2 text-xl font-bold">{item.title}</h3>
                <p class="mt-3 leading-7 text-slate-600">{item.description}</p>
                <span class="mt-5 inline-flex font-bold text-cyan-800">閱讀活動回顧 →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-slate-950 py-14 text-white">
      <div class="container-standard flex flex-col items-start justify-between gap-7 md:flex-row md:items-center">
        <div class="max-w-3xl">
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-300">也可配合 STEM Day</p>
          <h2 class="mt-3 text-2xl font-bold md:text-3xl">講座可獨立舉行，也可成為全校科技日的一部分</h2>
          <p class="mt-3 leading-7 text-slate-300">如學校同時需要課室工作坊或科技體驗，我們可按時間、場地和預算建議活動組合。</p>
        </div>
        <a href="/stemday/" class="shrink-0 rounded-lg border border-cyan-300/60 px-6 py-3 font-bold text-cyan-200 transition hover:bg-cyan-300 hover:text-slate-950">了解 STEM Day →</a>
      </div>
    </section>

    <section class="section-padding bg-white">
      <div class="container-standard grid gap-12 lg:grid-cols-[.72fr_1.28fr]">
        <div>
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">常見問題</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">安排學生講座前</h2>
          <p class="mt-5 leading-8 text-slate-600">只要提供學生年級、預計人數、初步日期與場地，我們便可建議合適的主題與安排。</p>
        </div>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="group rounded-xl border border-slate-200 bg-slate-50 p-5">
              <summary class="cursor-pointer list-none pr-8 font-bold marker:hidden">{faq.question}<span class="float-right text-cyan-700 group-open:rotate-45">＋</span></summary>
              <p class="mt-4 border-t border-slate-200 pt-4 leading-7 text-slate-600">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="contact-form" class="section-padding scroll-mt-24 bg-gradient-to-br from-cyan-50 to-slate-100">
      <div class="container-standard grid items-start gap-10 lg:grid-cols-[.75fr_1.25fr]">
        <div class="lg:sticky lg:top-28">
          <p class="text-sm font-bold tracking-[0.2em] text-cyan-700">下一步</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">索取講座資料及報價</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">告訴我們學生年級、預計人數、初步日期及感興趣的主題。我們會按學校需要建議合適的講座內容、場次與安排。</p>
          <p class="mt-6 rounded-xl bg-white p-5 text-sm leading-6 text-slate-600 shadow-sm">如需同日安排多場、配合主題周或加入 STEM Day，亦可在查詢時告訴我們。</p>
        </div>
        <div class="rounded-2xl bg-white p-6 shadow-xl md:p-9">
          <EnquiryForm interest="學生到校講座及報價" />
        </div>
      </div>
    </section>
  </div>
</Layout>
